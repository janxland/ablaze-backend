# Copy to .env.docker, set real values, and keep the file mode at 600.
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8181

# Host services. The migration record lists Redis as host port 26739.
DB_URL=jdbc:mysql://host.docker.internal:3306/ablaze?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&connectTimeout=3000&socketTimeout=5000
DB_USERNAME=ablaze
DB_PASSWORD=replace-me
DB_POOL_MAX_ACTIVE=8

REDIS_HOST=host.docker.internal
REDIS_PORT=26739
REDIS_USERNAME=default
REDIS_PASSWORD=replace-me
REDIS_DATABASE=0

RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=replace-me
RABBITMQ_PASSWORD=replace-me

MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me

ALIPAY_APP_ID=replace-me
ALIPAY_PRIVATE_KEY=replace-me
ALIPAY_PUBLIC_KEY=replace-me
ALIPAY_NOTIFY_URL=https://example.com/alipay/notify
PAYMENT_SECRET_KEY=replace-me
PAY_API_URL=http://host.docker.internal:8881/epay/createOrder
PAY_STATUS_API_URL=http://host.docker.internal:8881/epay/queryone

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400
LEGACY_CRYPTO_KEY=replace-with-the-existing-user-password-encryption-key
JWT_COMPAT_KEY=replace-with-the-existing-legacy-jwt-key

QINIU_ACCESS_KEY=replace-me
QINIU_SECRET_KEY=replace-me
QINIU_BUCKET=replace-me
